        "z": "986191c3c0907386",
        "name": "function 1",
        "func": "// Simulação de vibração de ADXL345 em 3 eixos\nlet vibX = (Math.random() * 2 - 1).toFixed(2); // Eixo X (-1 a 1 m/s²)\nlet vibY = (Math.random() * 2 - 1).toFixed(2);// Eixo X (-1 a 1 m/s²)\nlet vibZ = (9.81+(Math.random() * 0.5 - 0.25)).toFixed(2); // Eixo próximo da gravidade\n\nlet msgs = [];\n\nmsgs.push({topic: \"X\", payload: parseFloat(vibX)});\nmsgs.push({ topic: \"Y\", payload: parseFloat(vibY) });\nmsgs.push({ topic: \"Z\", payload: parseFloat(vibZ) });\nreturn [msgs];",
