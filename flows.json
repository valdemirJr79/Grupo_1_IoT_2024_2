        "name": "conversores",
        "func": "// Simulação de vibração de ADXL345 em 3 eixos\n// Eixo X (-1 a 1 m/s²)\nlet celsius = (Math.random() * 100 - 1).toFixed(2);// Eixo X (-1 a 1 m/s²)\nlet fahren = ( (9 / 5 * parseFloat(celsius)) + 32).toFixed(2);\nlet kelvin = ((parseFloat(celsius)+273.15).toFixed(2)); // Eixo próximo da gravidade\n\nlet msgs = [];\n\nmsgs.push({ topic: \"fahren\", payload: parseFloat(fahren) });\nmsgs.push({ topic: \"kelvin\", payload: parseFloat(kelvin) });\nmsgs.push({ topic: \"Celsius\", payload: parseFloat(celsius)});\nreturn [msgs];",
