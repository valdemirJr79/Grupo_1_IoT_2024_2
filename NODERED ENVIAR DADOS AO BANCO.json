    {
        "id": "0b39e335f3ab748a",
        "type": "function",
        "z": "99018d9797555cc3",
        "name": "Calculate Differential",
        "func": "let sensor1 = flow.get('sensor1');\nlet sensor2 = flow.get('sensor2');\n\nif (msg.topic === 'senai/temperatura/sensor1') {\n    sensor1 = Number(msg.payload);\n    flow.set('sensor1', sensor1);\n}\n\nif (msg.topic === 'senai/temperatura/sensor2') {\n    sensor2 = Number(msg.payload);\n    flow.set('sensor2', sensor2);\n}\n\n// espera os dois sensores\nif (sensor1 === undefined || sensor2 === undefined) {\n    return null;\n}\n\nlet differential = Math.abs(sensor1 - sensor2);\n\nlet status = 'NORMAL';\n\nif (differential > 5 && differential < 15) {\n    status = 'ALERT';\n}\n\nif (differential >= 15) {\n    status = 'DANGER';\n}\n\n// query mysql\nmsg.topic = `\nINSERT INTO temperaturas\n(sensor1, sensor2, diferencial, status)\nVALUES (?, ?, ?, ?)\n`;\n\nmsg.payload = [\n    sensor1,\n    sensor2,\n    differential,\n    status\n];\n\nnode.warn(msg);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
