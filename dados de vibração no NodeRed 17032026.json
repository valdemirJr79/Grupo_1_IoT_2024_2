    {
        "id": "919f4ef1b475465f",
        "type": "function",
        "z": "f315d63cd69e3585",
        "name": "Gerador Vibração",
        "func": "let t = context.get('t') || 0;\nt += 0.1;\ncontext.set('t', t);\n\nlet stages = [100, 200, 400, 600, 800, 1000];\nlet stageIndex = Math.floor(t / 10) % stages.length;\nlet amp_pp = stages[stageIndex];\nlet amp = amp_pp / 2;\n\nlet freq = 2;\nlet value = amp * Math.sin(2 * Math.PI * freq * t);\n\nmsg.payload = value;\nmsg.pp = (Math.abs(value) * 2).toFixed(1);\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 80,
        "wires": [
            [
                "dc57e422ec1aed9d",
                "455ec4319d96558d"
            ]
        ]
    },
    {
        "id": "455ec4319d96558d",
        "type": "function",
        "z": "f315d63cd69e3585",
        "name": "Valor para display",
        "func": "msg.payload = msg.pp;\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 160,
        "wires": [
