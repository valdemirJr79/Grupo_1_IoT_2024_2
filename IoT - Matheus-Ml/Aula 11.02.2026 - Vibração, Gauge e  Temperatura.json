        "type": "function",
        "z": "3fe58f7dad672042",
        "name": "Gauge Temp.",
        "func": "let limite = global.get(\"limiteTemp\") || 12;\nlet temp = msg.payload;\n\nif (temp >= limite){\n    msg.status = \"ALARME!\";\n    msg.color = \"red\";\n} else {\n    msg.status = \"Normal\";\n    msg.color = \"green\";\n}\n\nmsg.limite = limite;\nreturn msg;",
