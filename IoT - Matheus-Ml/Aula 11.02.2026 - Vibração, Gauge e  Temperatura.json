    {
        "id": "01727cd65787c6bb",
        "type": "function",
        "z": "3fe58f7dad672042",
        "name": "Gerar Temperatura",
        "func": "//Simulação de vibração do ADXL345 em 3 eixos\nlet min = -35;\nlet max = 35;\n\nlet Celsius = (Math.floor(Math.random() * (max - min + 1)) + min).toFixed(2); // Eixo Y (-1 a 1 m/s²)\nlet Fahrenheit = ((9 / 5 * parseFloat(Celsius) + 32 ).toFixed(2)); // Eixo X (-1 a 1 m/s²)\nlet Kelvin = (parseFloat(Celsius) + 273.15).toFixed(2); // Eixo Z próxima da gravidade\n\n//Enviar três mensagens separadas (para o gráfico identficar cada série)\nlet temp = [];\ntemp.push({topic: \"Fahrenheit\", payload: parseFloat(Fahrenheit)});\ntemp.push({topic: \"Kelvin\", payload: parseFloat(Kelvin)});\ntemp.push({topic: \"Celsius\", payload: parseFloat(Celsius)});\n\nreturn [temp];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
